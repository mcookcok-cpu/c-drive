# Salin ke .env lalu isi. Jangan commit file .env.
# Buat hash password dengan:  venv/bin/python scripts/set-password.py

APP_NAME=C-Drive
HOST=0.0.0.0
PORT=8000

# Login admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Kosongkan = dibuat acak otomatis dan disimpan di data/.secret_key
SECRET_KEY=

# Folder yang dibagikan (default di bawah ~/c-drive-files)
# C_DRIVE_HOME=~/c-drive-files
# DRIVE_ROOT=~/c-drive-files/drive
# DRIVE_WORK_ROOT=~/c-drive-files/work
# DRIVE_HOME_ROOT=~/c-drive-files/home

# Terminal web (shell di server). Set false kalau tidak dipakai.
ENABLE_TERMINAL=true

# Sesi dan keamanan
SESSION_HOURS=12
SESSION_COOKIE_SECURE=false   # set true bila diakses lewat HTTPS
TRUST_PROXY=false             # set true bila di belakang reverse proxy (nginx)
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SEC=600
# ALLOWED_HOSTS=drive.contoh.com   # host tambahan untuk cek Origin, pisahkan dengan koma

# Gunicorn
THREADS=32
LOG_LEVEL=INFO
ACCESS_LOG=false
